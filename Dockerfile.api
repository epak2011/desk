FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8000

WORKDIR /app
COPY requirements-api.txt ./
RUN pip install --no-cache-dir -r requirements-api.txt

COPY api_auth.py api_repository.py api_service.py ./
COPY attention_engine.py backend_layer.py public_contract.py user_state_store.py ./

RUN useradd --create-home --uid 10001 apiuser
USER apiuser

EXPOSE 8000
CMD ["sh", "-c", "uvicorn api_service:app --host 0.0.0.0 --port ${PORT}"]
